# Copy to .env.local and fill in. Never commit real keys.
# Everything here is TESTNET ONLY.

# --- Network
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_URL=https://testnet.nearblocks.io

# --- Provided by the team: a NAMED testnet account (e.g. telltale-team.testnet)
# with ~10 NEAR. Give EITHER the private key OR the wallet's 12-word seed phrase.
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=
OWNER_SEED_PHRASE=

# --- Written by `bun run setup:testnet`
VAULT_ACCOUNT_ID=
VAULT_DEPLOYER_PRIVATE_KEY=
REPORTER_ACCOUNT_ID=
REPORTER_PRIVATE_KEY=
SUPPLIER_ACCOUNT_IDS=
COLLECTOR_ACCOUNT_ID=
# ed25519 secret used only by the signer service to sign payment proofs
AGENT_PROOF_SECRET=
# comma-separated private keys of the vault's agent keys
AGENT_KEYS=
# 32 random bytes, hex; shared by the reporter and the MCP server
REPORT_HMAC_SECRET=

# --- Live LLM for the agent (optional; OpenAI-compatible). NEAR AI Cloud is used
# when its key is set, otherwise Groq. Without either, only the scripted agent runs.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Demo console
TELLTALE_DEMO=1
DEMO_CONSOLE_TOKEN=
# 1 = serve fixtures, no chain access (used by Playwright)
TELLTALE_MOCK=0

# --- MCP server
TELLTALE_REPORT_URL=http://localhost:3000/api/report
