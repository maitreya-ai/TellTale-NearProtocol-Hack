{
  "name": "@telltale/web",
  "version": "0.1.0",
  "private": true,
  "description": "Telltale landing page, dashboard, red-team console and API (Next.js on Cloudflare Workers via OpenNext)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@telltale/agent": "workspace:*",
    "@telltale/core": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lenis": "1.3.27",
    "lucide-react": "1.68.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "wrangler": "4.157.0"
  }
}
