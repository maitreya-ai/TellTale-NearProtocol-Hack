{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telltale",
  // Built by `opennextjs-cloudflare build` (Next.js → Cloudflare Workers adapter).
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Public, non-secret settings. Account ids and keys are set as secrets with
  // `bun run cf:secrets` (reads ../../.env.local). Local dev reads .dev.vars.
  "vars": {
    "NEAR_NETWORK": "testnet",
    "NEAR_RPC_URL": "https://test.rpc.fastnear.com",
    "NEAR_EXPLORER_URL": "https://testnet.nearblocks.io",
    "NEAR_AI_BASE_URL": "https://cloud-api.near.ai/v1",
    "NEAR_AI_MODEL": "deepseek-ai/DeepSeek-V4.1-Flash-1017",
    "TELLTALE_DEMO": "1",
    "TELLTALE_MOCK": "0",
    // Absolute base for social-card URLs (pages render in the Worker at request time).
    "SITE_URL": "https://telltale.maitreyak1806.workers.dev",
  },
  "env": {
    // Used by Playwright: `wrangler dev --env e2e` reads .dev.vars.e2e (simulation, no secrets).
    "e2e": {
      "vars": {
        "NEAR_NETWORK": "testnet",
        "NEAR_RPC_URL": "https://test.rpc.fastnear.com",
        "NEAR_EXPLORER_URL": "https://testnet.nearblocks.io",
        "NEAR_AI_BASE_URL": "https://cloud-api.near.ai/v1",
        "NEAR_AI_MODEL": "deepseek-ai/DeepSeek-V4.1-Flash-1017",
        "TELLTALE_DEMO": "1",
        "TELLTALE_MOCK": "1",
      },
    },
  },
}
